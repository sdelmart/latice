<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="latice.controleur.ControleurChargement"
           stylesheets="@../css/theme.css">

    <Region fx:id="fondRegion" maxHeight="Infinity" maxWidth="Infinity" />
    <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="scrim" />

    <VBox alignment="CENTER" spacing="16">
        <padding>
            <Insets bottom="0" left="60" right="60" top="0" />
        </padding>
        <Label styleClass="title-latice" text="LATICE" />
        <Label styleClass="subtitle" text="Préparation de la partie..." />
        <ProgressBar fx:id="progressBar" progress="0" prefWidth="420" styleClass="progress-ocean">
            <VBox.margin>
                <Insets top="10" />
            </VBox.margin>
        </ProgressBar>
    </VBox>

</StackPane>
