<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="440" prefWidth="360" stylesheets="@../css/theme.css" xmlns="http://javafx.com/javafx/8.0.241" xmlns:fx="http://javafx.com/fxml/1" fx:controller="latice.controleur.ControleurParametres">
    <children>
        <Region fx:id="fondRegion" maxHeight="Infinity" maxWidth="Infinity" />
        <Region maxHeight="Infinity" maxWidth="Infinity" styleClass="scrim" />
        <VBox alignment="CENTER" spacing="14">
            <padding>
                <Insets bottom="24" left="24" right="24" top="20" />
            </padding>
            <Label styleClass="section-label" text="PARAMÈTRES" />
            <VBox alignment="CENTER" spacing="8">
                <Label styleClass="label-light" text="Musique" />
                <ComboBox fx:id="choixMusique" maxWidth="260.0" prefWidth="260.0" />
            </VBox>
            <VBox alignment="CENTER" spacing="8">
                <Label styleClass="label-light" text="Volume" />
                <Slider fx:id="sliderVolume" max="1" maxWidth="260.0" min="0" prefWidth="260.0" value="0.5" />
            </VBox>
            <CheckBox fx:id="caseEffetsSonores" styleClass="label-light" text="Effets sonores (clics, pose de tuile)" />
            <VBox alignment="CENTER" spacing="8">
                <Label styleClass="label-light" text="Fond d'écran" />
                <ComboBox fx:id="choixFond" maxWidth="260.0" prefWidth="260.0" />
            </VBox>
            <HBox alignment="CENTER" spacing="12">
                <Button onAction="#ouvrirRegles" styleClass="btn-secondary" text="Règles" />
                <Button onAction="#fermerFenetre" styleClass="btn-primary" text="Fermer" />
            </HBox>
        </VBox>
    </children>
</StackPane>
